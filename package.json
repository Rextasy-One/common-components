{
  "name": "@aws-rex/common-components",
  "version": "1.0.0",
  "private": false,
  "description": "Shared header, footer and navigation primitives for Aws Rex frontends.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./header": {
      "types": "./src/Header.tsx",
      "default": "./src/Header.tsx"
    },
    "./footer": {
      "types": "./src/Footer.tsx",
      "default": "./src/Footer.tsx"
    }
  },
  "files": [
    "src",
    "!src/**/*.test.*",
    "!src/test"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prettier": "@aws-rex/config/prettier",
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@aws-rex/config": "^1.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
