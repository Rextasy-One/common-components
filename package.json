{
  "name": "@aws-rex/common-components",
  "version": "1.0.0",
  "private": false,
  "description": "Shared header, footer and navigation primitives for Aws Rex frontends.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./header": {
      "types": "./src/Header.tsx",
      "default": "./src/Header.tsx"
    },
    "./footer": {
      "types": "./src/Footer.tsx",
      "default": "./src/Footer.tsx"
    }
  },
  "files": [
    "src",
    "!src/**/*.test.*",
    "!src/test"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
